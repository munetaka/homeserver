      "title": "日別振り返り: 快適率(全室) / 空調kWh / 日射kWh — 常に直近14日表示",
      "description": "快適率 = 全部屋(屋外除く)が室温22〜26.5℃かつ絶対湿度7〜12.5g/m³に収まっていた時間の割合。",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "timeFrom": "14d",
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "快適率"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.drawStyle",
                "value": "bars"
              },
              {
                "id": "custom.fillOpacity",
                "value": 50
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/kWh/"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "快適率",
          "interval": "1d",
          "expr": "100 * avg(avg_over_time(((climate_temperature{location!~\".*屋外.*\"} > bool 22) * (climate_temperature{location!~\".*屋外.*\"} < bool 26.5) * (climate_abs_humidity{location!~\".*屋外.*\"} > bool 7) * (climate_abs_humidity{location!~\".*屋外.*\"} < bool 12.5))[1d:10m]))"
        },
        {
          "refId": "B",
